import random
import zipfile
from pathlib import Path

import albumentations as A
import numpy as np
import rasterio
from rasterio.windows import Window
import segmentation_models_pytorch as smp
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, Dataset


def set_seed(seed: int = 42) -> None:
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)


set_seed(42)
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Using device: {device}")

# 1. Data Extraction & Paths
BASE_DIR = Path(".")
ZIP_PATH = BASE_DIR / "result_V4.zip"
DATA_DIR = BASE_DIR / "data_V4"
TILES_DIR = BASE_DIR / "dataset_V5"
OUTPUT_DIR = BASE_DIR / "outputs"
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

if ZIP_PATH.exists() and not DATA_DIR.exists():
    with zipfile.ZipFile(ZIP_PATH, "r") as zf:
        zf.extractall(DATA_DIR)
    nested = [p for p in DATA_DIR.iterdir() if p.is_dir() and not p.name.startswith("__")]
    if len(nested) == 1:
        DATA_DIR = nested[0]


# 2. Sliding-Window Tiling (Training District: Kreis 9)
def create_sliding_chips(
    ortho_path: Path,
    mask_path: Path,
    output_dir: Path,
    dataset_name: str,
    chip_size: int = 400,
    stride: int = 200,
) -> None:
    img_dir = output_dir / dataset_name / "images"
    msk_dir = output_dir / dataset_name / "masks"
    img_dir.mkdir(parents=True, exist_ok=True)
    msk_dir.mkdir(parents=True, exist_ok=True)

    saved = 0
    with rasterio.open(ortho_path) as src_img, rasterio.open(mask_path) as src_msk:
        if src_img.shape != src_msk.shape:
            raise ValueError(f"Raster dimension mismatch for {dataset_name}")

        height, width = src_img.height, src_img.width
        meta_img = src_img.meta.copy()
        meta_msk = src_msk.meta.copy()
        meta_img.update({"driver": "GTiff", "height": chip_size, "width": chip_size})
        meta_msk.update({"driver": "GTiff", "height": chip_size, "width": chip_size})

        for row in range(0, height, stride):
            for col in range(0, width, stride):
                win_h = min(chip_size, height - row)
                win_w = min(chip_size, width - col)
                window = Window(col, row, win_w, win_h)

                patch_img = src_img.read(window=window)[:3]
                patch_msk = src_msk.read(1, window=window)

                padded_img = np.zeros((3, chip_size, chip_size), dtype=patch_img.dtype)
                padded_msk = np.full((1, chip_size, chip_size), 255, dtype=patch_msk.dtype)
                padded_img[:, :win_h, :win_w] = patch_img
                padded_msk[0, :win_h, :win_w] = patch_msk

                if np.all(padded_msk == 255):
                    continue

                win_transform = src_img.window_transform(window)
                meta_img["transform"] = win_transform
                meta_msk["transform"] = win_transform

                with rasterio.open(img_dir / f"{dataset_name}_{saved:04d}.tif", "w", **meta_img) as dst:
                    dst.write(padded_img)
                with rasterio.open(msk_dir / f"{dataset_name}_{saved:04d}.tif", "w", **meta_msk) as dst:
                    dst.write(padded_msk)

                saved += 1

    print(f"{dataset_name}: {saved} tiles generated (stride={stride}px)")


create_sliding_chips(
    DATA_DIR / "1m_Kreis9_2013.tif",
    DATA_DIR / "rasterized_Kreis9_2013_1m.tif",
    TILES_DIR,
    "Kreis9_2013",
    stride=200,
)
create_sliding_chips(
    DATA_DIR / "1m_Kreis9_2024.tif",
    DATA_DIR / "rasterized_Kreis9_2024_1m_richtig.tif",
    TILES_DIR,
    "Kreis9_2024",
    stride=200,
)


# 3. Dataset & Augmentations
IMAGENET_MEAN = (0.485, 0.456, 0.406)
IMAGENET_STD = (0.229, 0.224, 0.225)

train_transform = A.Compose([
    A.HorizontalFlip(p=0.5),
    A.VerticalFlip(p=0.5),
    A.RandomRotate90(p=0.5),
    A.HueSaturationValue(hue_shift_limit=25, sat_shift_limit=35, val_shift_limit=30, p=0.8),
    A.RandomBrightnessContrast(brightness_limit=0.25, contrast_limit=0.25, p=0.7),
    A.GaussianBlur(blur_limit=(3, 5), p=0.2),
    A.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),
])

val_transform = A.Compose([
    A.Normalize(mean=IMAGENET_MEAN, std=IMAGENET_STD),
])


class SealedSurfaceDataset(Dataset):
    def __init__(self, img_paths: list[Path], mask_paths: list[Path], transform=None):
        self.img_paths = img_paths
        self.mask_paths = mask_paths
        self.transform = transform

    def __len__(self) -> int:
        return len(self.img_paths)

    def __getitem__(self, idx: int) -> tuple[torch.Tensor, torch.Tensor]:
        with rasterio.open(self.img_paths[idx]) as src:
            img = np.transpose(src.read()[:3], (1, 2, 0)).astype(np.uint8)
        with rasterio.open(self.mask_paths[idx]) as src:
            mask = src.read(1).astype(np.int64)

        if self.transform:
            augmented = self.transform(image=img, mask=mask)
            img, mask = augmented["image"], augmented["mask"]

        img_tensor = torch.from_numpy(np.transpose(img, (2, 0, 1))).float()
        mask_tensor = torch.from_numpy(mask).long()
        return img_tensor, mask_tensor


img_paths, mask_paths = [], []
for subset in ("Kreis9_2013", "Kreis9_2024"):
    for img_file in sorted((TILES_DIR / subset / "images").glob("*.tif")):
        msk_file = TILES_DIR / subset / "masks" / img_file.name
        if msk_file.exists():
            img_paths.append(img_file)
            mask_paths.append(msk_file)

rng = np.random.default_rng(42)
indices = rng.permutation(len(img_paths))
split = int(0.9 * len(indices))

train_ds = SealedSurfaceDataset([img_paths[i] for i in indices[:split]], [mask_paths[i] for i in indices[:split]], train_transform)
val_ds = SealedSurfaceDataset([img_paths[i] for i in indices[split:]], [mask_paths[i] for i in indices[split:]], val_transform)

train_loader = DataLoader(train_ds, batch_size=12, shuffle=True, drop_last=True)
val_loader = DataLoader(val_ds, batch_size=12, shuffle=False)


# 4. U-Net Model, Training & Validation Threshold Tuning
model = smp.Unet(
    encoder_name="resnet34",
    encoder_weights="imagenet",
    in_channels=3,
    classes=2,
).to(device)

ce_loss = nn.CrossEntropyLoss(ignore_index=255)
dice_loss = smp.losses.DiceLoss(mode="multiclass", ignore_index=255)
optimizer = torch.optim.AdamW(model.parameters(), lr=3e-4, weight_decay=1e-4)
epochs = 20
scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)

for epoch in range(1, epochs + 1):
    model.train()
    running_loss = 0.0
    for imgs, masks in train_loader:
        imgs, masks = imgs.to(device), masks.to(device)
        optimizer.zero_grad()
        logits = model(imgs)
        loss = 0.5 * ce_loss(logits, masks) + 0.5 * dice_loss(logits, masks)
        loss.backward()
        optimizer.step()
        running_loss += loss.item()
    scheduler.step()

    if epoch == 1 or epoch % 5 == 0:
        print(f"Epoch {epoch:02d}/{epochs:02d} - Train Loss: {running_loss / len(train_loader):.4f}")

model.eval()
val_probs, val_targets = [], []
with torch.no_grad():
    for imgs, masks in val_loader:
        probs = torch.softmax(model(imgs.to(device)), dim=1)[:, 1].cpu()
        valid = masks != 255
        val_probs.append(probs[valid])
        val_targets.append(masks[valid])

val_probs = torch.cat(val_probs)
val_targets = torch.cat(val_targets)

best_thresh, best_f1 = 0.5, 0.0
for th in np.arange(0.30, 0.65, 0.05):
    preds = (val_probs >= th).long()
    tp = ((preds == 1) & (val_targets == 1)).sum().item()
    fp = ((preds == 1) & (val_targets == 0)).sum().item()
    fn = ((preds == 0) & (val_targets == 1)).sum().item()
    f1 = 2 * tp / (2 * tp + fp + fn + 1e-6)
    if f1 > best_f1:
        best_f1, best_thresh = f1, float(th)

print(f"Optimal validation threshold: {best_thresh:.2f} (Kreis 9 Val F1: {best_f1:.4f})")
torch.save(model.state_dict(), OUTPUT_DIR / "unet_resnet34_kreis9_v5.pth")


# 5. Seamless Inference & Evaluation on Unseen Test District (Kreis 11)
def predict_full_raster(
    ortho_path: Path,
    mask_path: Path,
    chip_size: int = 400,
    stride: int = 350,
) -> tuple[np.ndarray, np.ndarray, dict]:
    mean = torch.tensor(IMAGENET_MEAN, device=device).view(1, 3, 1, 1)
    std = torch.tensor(IMAGENET_STD, device=device).view(1, 3, 1, 1)

    wy = np.hanning(chip_size)[:, None] + 0.05
    wx = np.hanning(chip_size)[None, :] + 0.05
    weight_patch = (wy * wx).astype(np.float32)

    with rasterio.open(ortho_path) as src_img, rasterio.open(mask_path) as src_msk:
        height, width = src_img.height, src_img.width
        prob_sum = np.zeros((height, width), dtype=np.float32)
        weight_sum = np.zeros((height, width), dtype=np.float32)
        ref_mask = src_msk.read(1)
        meta = src_msk.meta.copy()

        model.eval()
        with torch.no_grad():
            for row in range(0, height, stride):
                for col in range(0, width, stride):
                    win_h = min(chip_size, height - row)
                    win_w = min(chip_size, width - col)
                    window = Window(col, row, win_w, win_h)

                    patch = src_img.read(window=window)[:3].astype(np.float32) / 255.0
                    padded = np.zeros((3, chip_size, chip_size), dtype=np.float32)
                    padded[:, :win_h, :win_w] = patch

                    tensor_in = (torch.from_numpy(padded).unsqueeze(0).to(device) - mean) / std
                    prob = torch.softmax(model(tensor_in), dim=1)[0, 1].cpu().numpy()

                    w_crop = weight_patch[:win_h, :win_w]
                    prob_sum[row : row + win_h, col : col + win_w] += prob[:win_h, :win_w] * w_crop
                    weight_sum[row : row + win_h, col : col + win_w] += w_crop

    prob_full = prob_sum / np.maximum(weight_sum, 1e-6)
    prob_full = np.where(ref_mask != 255, prob_full, -9999.0).astype(np.float32)
    return prob_full, ref_mask, meta


def evaluate_predictions(prob_map: np.ndarray, ref_map: np.ndarray, label: str, thresh: float) -> tuple[int, int]:
    valid = ref_map != 255
    pred_bin = prob_map[valid] >= thresh
    ref_bin = ref_map[valid] == 1

    tp = np.logical_and(pred_bin, ref_bin).sum()
    fp = np.logical_and(pred_bin, ~ref_bin).sum()
    fn = np.logical_and(~pred_bin, ref_bin).sum()

    precision = tp / (tp + fp + 1e-6)
    recall = tp / (tp + fn + 1e-6)
    f1 = 2 * precision * recall / (precision + recall + 1e-6)
    iou = tp / (tp + fp + fn + 1e-6)

    print(f"[{label} | t={thresh:.2f}] Precision: {precision:.4f} | Recall: {recall:.4f} | F1: {f1:.4f} | IoU: {iou:.4f}")
    print(f"[{label}] Predicted unsealed: {pred_bin.sum():,} m² | Reference unsealed: {ref_bin.sum():,} m²")
    return int(pred_bin.sum()), int(ref_bin.sum())


prob_2013, ref_2013, meta_2013 = predict_full_raster(
    DATA_DIR / "1m_Kreis11_2013.tif",
    DATA_DIR / "rasterized_Kreis11_2013_1m.tif",
)
prob_2024, ref_2024, meta_2024 = predict_full_raster(
    DATA_DIR / "1m_Kreis11_2024.tif",
    DATA_DIR / "rasterized_Kreis11_2024_1m_richtig.tif",
)

pred_13, ref_13 = evaluate_predictions(prob_2013, ref_2013, "Kreis 11 - 2013", best_thresh)
pred_24, ref_24 = evaluate_predictions(prob_2024, ref_2024, "Kreis 11 - 2024", best_thresh)

print(f"Raw model delta (2013->2024):     {pred_24 - pred_13:+,d} m² ({(pred_24 - pred_13) / pred_13 * 100:+.2f}%)")
print(f"Reference delta (2013->2024):     {ref_24 - ref_13:+,d} m² ({(ref_24 - ref_13) / ref_13 * 100:+.2f}%)")

for filename, array, meta in [
    ("Oerlikon_Prob_2013_V5.tif", prob_2013, meta_2013),
    ("Oerlikon_Prob_2024_V5.tif", prob_2024, meta_2024),
]:
    out_meta = meta.copy()
    out_meta.update({"count": 1, "dtype": "float32", "nodata": -9999.0})
    with rasterio.open(OUTPUT_DIR / filename, "w", **out_meta) as dst:
        dst.write(array, 1)
